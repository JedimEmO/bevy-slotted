-- or, in .luaurc:
--
--     { "aliases": {}, "languageMode": "strict" }
--
-- with `luau-lsp.types.definitionFiles` set to this path in your editor.

--- The `type` field of an event handed to a `slotted.on` handler, which is also
--- the name you subscribe with.
export type EventName =
	| "data_stage"
	| "control_start"
	| "slot_click"
	| "widget_activate"
	| "tooltip_build"
	| "recipe_lookup"
	| "screen_opened"
	| "screen_closed"
	| "hud_tick"
	| "search_changed"
	| "property_changed"
	| "test_list"
	| "test_run"
	| "test_resume"

--- The `type` field of a command a script returns. You never write these
--- literals: `slotted.cmd.*` and the `register_*` calls build them.
export type CommandName =
	| "register_item"
	| "register_tag"
	| "register_recipe_type"
	| "register_recipe"
	| "register_screen"
	| "register_widget"
	| "inject"
	| "add_tooltip_part"
	| "sort"
	| "quick_stack"
	| "move"
	| "toggle_favorite"
	| "click"
	| "register_fluid"
	| "register_hud_layer"
	| "set_hud"
	| "hud_update"
	| "test_list"
	| "test_step"
	| "test_done"
	| "log"
	| "deprecated"
	| "subscribe"

export type Button = "left" | "right" | "middle"
export type Tier = "compact" | "expanded"
export type LookupMode = "recipes" | "uses"
export type LogLevel = "trace" | "debug" | "info" | "warn" | "error"

export type Modifiers = { shift: boolean, ctrl: boolean, alt: boolean }

--- A stack as a script sees it: names, not interned ids.
export type StackInfo = {
	item: string,
	count: number,
	components: { [string]: any },
}

--- A command table. Build these with `slotted.cmd.*` rather than by hand.
export type Command = { type: CommandName, [string]: any }

--- The event tables, by their `type` field.
export type DataStageEvent = { type: "data_stage", api_version: number }
export type ControlStartEvent = { type: "control_start", api_version: number, mods: { string } }
export type SlotClickEvent = { type: "slot_click", menu: number, screen: string, slot: number, button: Button, modifiers: Modifiers, stack: StackInfo? }
export type WidgetActivateEvent = { type: "widget_activate", menu: number?, screen: string, widget: string, tags: { [string]: string } }
export type TooltipBuildEvent = { type: "tooltip_build", stack: StackInfo, tier: Tier }
export type RecipeLookupEvent = { type: "recipe_lookup", item: string, mode: LookupMode }
export type ScreenOpenedEvent = { type: "screen_opened", menu: number?, screen: string }
export type ScreenClosedEvent = { type: "screen_closed", menu: number?, screen: string }
export type HudTickEvent = { type: "hud_tick", elapsed_ms: number }
export type SearchChangedEvent = { type: "search_changed", text: string }
export type PropertyChangedEvent = { type: "property_changed", menu: number, screen: string, property: number, value: number }

--- Command builders. A control handler returns one of these, or an array of them.
export type SlottedCmd = {
	--- Sort one inventory of a menu. Becomes the same `MenuAction` the built-in action rail sends, so prediction and the authority see an ordinary click.
	sort: (menu: number, inventory: number?) -> { [string]: any },
	--- Move every stack in `from` that already has a home in `to` across.
	quick_stack: (menu: number, from: number, to: number) -> { [string]: any },
	--- Move a stack between two slots, as a plan of ordinary clicks.
	move: (menu: number, from: number, to: number) -> { [string]: any },
	--- Mark or unmark a slot as a favourite, which sorting keeps in place.
	toggle_favorite: (menu: number, slot: number) -> { [string]: any },
	--- Send any click action verbatim. The escape hatch, for the modes the other commands do not cover.
	click: (menu: number, action: { [string]: any }) -> { [string]: any },
	--- Replace parts of a HUD layer. An unknown layer id creates one on top.
	set_hud: (layer: string, value: { [string]: any }) -> { [string]: any },
	--- Write one value into a HUD layer's node, found by its `test_id`. A string sets text, a boolean sets visibility, a number or a `{ value, max }` pair sets a fill. Cheaper than replacing the tree every tick.
	hud_update: (layer: string, path: string, value: any) -> { [string]: any },
	--- Append nodes to the tooltip being composed. Only valid in reply to a `tooltip_build` event, where the filters of a static part make no sense.
	tooltip: (nodes: { any }) -> { [string]: any },
	--- Build a console line as a command, for when you want it ordered with the rest of a handler's reply rather than emitted immediately.
	log: (level: string, message: any) -> { [string]: any },
}

--- The harness a mod's tests/*.lua drives. Only present in the test stage.
export type SlottedTest = {
	--- Register a test. The body runs as a coroutine: every action below yields to the harness and resumes with its answer, so the test reads as straight-line code while the app advances frames between the lines.
	test: (name: string, fn: () -> ()) -> (),
	--- Open a screen over a fixture's inventories. Every test starts here.
	open_screen: (kind: string, fixture: (string | { [string]: any })?) -> { [string]: any },
	--- Left-click a node. A locator is a table with any of these keys, all of which must match: `role` is a semantic role in snake case (`"slot"`, `"side_tab"`, `"hud_layer"`), `tag` is a map of tags, `test_id` is the `test_id` tag, `text` is the displayed text, `widget` is a `namespace:path` widget kind, `item` matches a slot holding that item, and `index` picks the nth match in tree order.
	click: (loc: { [string]: any }) -> (),
	--- Shift-click a node, which is the quick-move mode.
	shift_click: (loc: { [string]: any }) -> (),
	--- Right-click a node: pick up half, or place one.
	right_click: (loc: { [string]: any }) -> (),
	--- Move the pointer over a node and leave it there, which is what raises a tooltip.
	hover: (loc: { [string]: any }) -> (),
	--- Press and release one key.
	key: (key: string) -> (),
	--- Type text into the focused node.
	type_text: (text: string) -> (),
	--- Advance virtual time until layout and motion are quiet. Call it after any action whose effect takes a frame to appear.
	settle: () -> (),
	--- Advance exactly `frames` frames, for the cases where settling would hide a transient state.
	step: (frames: number?) -> (),
	--- Advance an icon button to its next state, or its previous one.
	cycle: (loc: { [string]: any }, forward: boolean?) -> (),
	--- Press and release one gamepad button. The harness owns one pad; the press lands on it and the UI reads it through `UiBindings` like any other.
	gamepad: (button: string) -> (),
	--- Perform a UI action through the first keyboard key bound to it, so a test reads as what the player meant rather than which key they pressed.
	action: (name: string) -> (),
	--- What is in a slot.
	stack_at: (loc: { [string]: any }) -> { item: string, count: number }?,
	--- The rendered text of a node, after localisation.
	text_of: (loc: { [string]: any }) -> string?,
	--- The current value of the menu property a node is bound to.
	property_of: (loc: { [string]: any }) -> { id: number, value: number }?,
	--- How full a tank is, from `0.0` to `1.0`.
	tank_fill: (loc: { [string]: any }) -> number?,
	--- Whether a node exists and is visible.
	is_visible: (loc: { [string]: any }) -> boolean,
	--- Whether any console line so far contains `text`. The way to assert on what a script logged.
	log_contains: (text: string) -> boolean,
	--- The tags of the node that has focus, which is where the focus ring sits and what `accept` would activate.
	focused: () -> { [string]: string }?,
	--- Fail the test unless `cond` is truthy. Expectations are plain Lua and do not yield.
	expect: (cond: any, msg: string?) -> (),
	--- Fail the test unless `a == b`, reporting both values.
	expect_eq: (a: any, b: any, msg: string?) -> (),
	--- Fail the test unless a slot holds exactly this. Pass `nil` for `item` to assert the slot is empty.
	expect_stack: (loc: { [string]: any }, item: string?, count: number?) -> (),
}

--- The global every script sees. Read-only: assigning into it raises.
export type Slotted = {
	--- The API version this host speaks. Compare it against your `mod.toml` `api_version` if you need to branch on host age.
	api_version: number,
	--- Your own mod id, as written in `mod.toml`. Bare ids you pass to any `register_*` call are namespaced with it.
	mod_id: string,
	--- Which stage this chunk is running in: `"data"`, `"control"` or `"test"`.
	stage: string,
	--- Add an item to the registry, or replace one another mod registered.
	register_item: (id: string, def: { [string]: any }) -> (),
	--- Add a tag, or add entries to one that already exists. Tags merge across mods, so naming a tag another mod owns extends it rather than replacing it.
	register_tag: (id: string, def: { [string]: any }) -> (),
	--- Add a recipe type. The item browser gives each type its own tab.
	register_recipe_type: (id: string, def: { [string]: any }) -> (),
	--- Add a recipe.
	register_recipe: (id: string, def: { [string]: any }) -> (),
	--- Add a fluid, so a `tank` node can name it and paint itself in its colour.
	register_fluid: (id: string, def: { [string]: any }) -> (),
	--- Add a HUD layer: a small tree drawn over the world rather than inside a screen. The player can move it with the position editor in dev builds.
	register_hud_layer: (id: string, def: { [string]: any }) -> (),
	--- Add a screen. `tree` is a `ScreenDef` body: the same shape a `.screen.ron` file has, minus the `kind`, which is filled in from `id`.
	register_screen: (id: string, tree: { [string]: any }) -> (),
	--- Add a reusable node template. A `custom` node naming this id is replaced by the template, with its own children spliced into the template's `children` anchor.
	register_widget: (id: string, template: { [string]: any }) -> (),
	--- Splice a node into a screen at a named anchor, including a screen your mod does not own. This is the whole extension story: name a screen kind and an anchor, and the host does the splicing when that screen spawns.
	inject: (screen_kind: string, spec: { [string]: any }) -> (),
	--- Add nodes to the tooltip of every stack that matches a filter. Both filters empty means every stack.
	add_tooltip_part: (spec: { [string]: any }) -> (),
	--- Subscribe to a host event. The handler is called with the event table and returns nothing, one command table, or an array of them. Several handlers may share an event; they run in registration order. A handler must not register anything. Registries are frozen by the time the control stage runs.
	on: (event_name: string, handler: (event: { [string]: any }) -> any) -> (),
	--- Write a console line immediately. Extra arguments are formatted into `fmt` with `string.format`.
	log: (level: string, fmt: string, ...any) -> (),
	--- `slotted.log("info", ...)`.
	info: (fmt: string, ...any) -> (),
	--- `slotted.log("warn", ...)`.
	warn: (fmt: string, ...any) -> (),
	--- `slotted.log("error", ...)`. Logging an error does not stop the script; to fail, call Lua's `error`.
	error: (fmt: string, ...any) -> (),
	--- Command builders.
	cmd: SlottedCmd,
	--- The test harness, in the test stage only.
	test: SlottedTest?,
}

declare slotted: Slotted
declare print: (...any) -> ()

