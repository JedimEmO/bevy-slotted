// "Field Manual", the second slotted theme. Direction B of
// docs/research/research-modern-ui.md section 5 and docs/moodboard.html
// section 02: opaque paper over a dotted grid, ink rules, square slots with
// hard ink shadows, rarity as dashed stamp outlines, crisp 120-160 ms motion
// with no springs and a stamp-down drop. Nothing here is translucent and
// nothing is blurred.
//
// Type is IBM Plex Sans with Plex Mono counts, shipped under assets/fonts/
// with their OFL.txt. A game that would rather ask the OS for the family can
// drop `path:` from the two tokens below and set `system: true` instead,
// which needs Bevy's `system_font_discovery` feature.
#![enable(implicit_some)]
(
    name: "paper",
    tokens: (
        spacing: (xs: 2.0, sm: 6.0, md: 14.0, lg: 20.0, xl: 32.0),
        sizes: (control_height: 36.0, control_height_compact: 24.0),
        radii: (sm: 2.0, md: 2.0, lg: 2.0),
        elevation: {
            // A hard ink offset, no blur: the moodboard's `2px 2px 0 ink`.
            "ink":  (x: 2.0, y: 2.0, blur: 0.0, spread: 0.0, color: "$ink"),
            // The panel's soft paper shadow.
            "low":  (x: 0.0, y: 3.0, blur: 6.0,  spread: 0.0, color: "#1E1B1833"),
            "mid":  (x: 0.0, y: 6.0, blur: 14.0, spread: 0.0, color: "#1E1B1840"),
            "high": (x: 0.0, y: 8.0, blur: 22.0, spread: 1.0, color: "#1E1B184D"),
        },
        durations: (fast: 120, normal: 160, slow: 200, hover_delay: 70),
        motion: (
            easing: Standard,
            presets: {
                // The stamp: the squash gathers speed and lands dead.
                DropSquash: (duration: 140, easing: Stamp),
                Fade: (duration: 120, easing: EaseInOut),
                Stagger: (duration: 160, easing: Standard),
                // Paper allows no springs, so the flight keeps the
                // direction's ease-out and only loses the extra length.
                FlyToSlot: (duration: 120, easing: Standard),
                // A page turn: slow both ends, no spring.
                Slide: (duration: 160, easing: EaseInOut),
            },
        ),
        fonts: {
            "body": (family: "IBM Plex Sans", path: "fonts/ibm-plex-sans/IBMPlexSans-Variable.ttf"),
            "mono": (family: "IBM Plex Mono", path: "fonts/ibm-plex-mono/IBMPlexMono-Regular.ttf"),
        },
        // Menus M1: the type scale, all IBM Plex; labels in the mono.
        typography: {
            "display": (size: 36.0, font: "body", weight: 700),
            "title":   (size: 22.0, font: "body", weight: 600),
            "heading": (size: 17.0, font: "body", weight: 600),
            "body":    (size: 14.0, font: "body", line_height: 1.45),
            "label":   (size: 12.0, font: "mono"),
            "caption": (size: 11.0, font: "body"),
        },
        blur: (radius: 0.0, backdrop_divisor: 4),
        palette: {
            "paper":    "#EDE6D6",
            "sheet":    "#F7F2E6",
            "ink":      "#1E1B18",
            "rule":     "#C9BFA8",
            "orange":   "#E0672B",
            "teal":     "#2B8C86",
            "text":     "#1E1B18",
            "muted":    "#1E1B18B3",
            "danger":   "#B8322A",
            "shade":    "#E2D9C4",
        },
        rarity: {
            "common":    "#1E1B18",
            "uncommon":  "#2B8C86",
            "rare":      "#E0672B",
            "epic":      "#6B4FA0",
            "legendary": "#B8322A",
        },
    ),
    roles: {
        // The panel is a sheet of paper on a dotted grid: the tile carries
        // its own opaque ground, so no glass and no tint.
        "panel": Tiled(
            image: "themes/paper-dot.png",
            border: "$ink",
            radius: 2.0,
            elevation: "mid",
        ),
        "panel.title": Text(color: "$ink", size: "$title"),

        // Square slots on lighter sheet, ink rule, hard ink shadow.
        "slot": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "ink"),
        "slot.hover": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0, elevation: "ink"),
        "slot.focus": Solid(fill: "$sheet", border: "$teal", radius: 2.0, elevation: "ink"),
        "slot.carried": Solid(fill: "#FBE9DD", border: "$orange", radius: 2.0, elevation: "ink"),
        "slot.favorite": Solid(fill: "#FFF3D6", border: "$orange", radius: 2.0, elevation: "ink"),

        // Rarity is a dashed stamp outline inside the slot, in the rarity's
        // ink. Common draws nothing.
        "slot.rarity": Solid(fill: "#00000000", radius: 2.0),
        "slot.rarity.common": Solid(fill: "#00000000", radius: 2.0),
        "slot.rarity.uncommon": Dashed(fill: "#00000000", stroke: "$teal", width: 2.0, dash: 3.0, gap: 3.0, radius: 2.0),
        "slot.rarity.rare": Dashed(fill: "#00000000", stroke: "$orange", width: 2.0, dash: 3.0, gap: 3.0, radius: 2.0),
        "slot.rarity.epic": Dashed(fill: "#00000000", stroke: "#6B4FA0", width: 2.0, dash: 3.0, gap: 3.0, radius: 2.0),
        "slot.rarity.legendary": Dashed(fill: "#00000000", stroke: "$danger", width: 2.0, dash: 2.0, gap: 2.0, radius: 2.0),

        "slot.durability": Solid(fill: "$rule", radius: 0.0),

        "carried": Solid(fill: "#00000000", radius: 2.0),
        // Ink on paper: the good ring is the teal rule, the bad one the
        // orange stamp. `slot.phantom` and `slot.hint` tint an `ImageNode`.
        "carried.good": Solid(fill: "#00000000", border: "$teal", radius: 2.0),
        "carried.bad": Solid(fill: "#00000000", border: "$orange", radius: 2.0),
        "slot.phantom": Solid(fill: "#1E1B1899"),
        "slot.hint": Solid(fill: "#1E1B1859"),

        // A tooltip is an index card.
        "tooltip": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "mid"),
        "tooltip.frame": Solid(fill: "#00000000", border: "$rule", radius: 2.0),
        "tooltip.title": Text(color: "$ink", size: 14.0, font: "body"),

        "button": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "ink"),
        "button.primary": Solid(fill: "$orange", border: "$ink", radius: 2.0, elevation: "ink"),
        "button.hover": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0, elevation: "ink"),

        "text": Text(color: "$text", size: "$body"),
        "text.muted": Text(color: "$muted", size: "$caption"),
        "count": Text(color: "$ink", size: "$caption", font: "mono"),

        // The action rail is a ruled margin.
        "rail": Solid(fill: "$shade", border: "$ink", radius: 2.0),
        "rail.button": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "ink"),

        // The browser is the encyclopedia: a second sheet, one shade darker
        // than the screen, on the same grid.
        "browser.panel": Tiled(
            image: "themes/paper-dot.png",
            tint: "#F2EEE6",
            border: "$ink",
            radius: 2.0,
            elevation: "low",
        ),
        "browser.card": Solid(fill: "$sheet", border: "$rule", radius: 2.0),
        "browser.card.hover": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0, elevation: "ink"),
        "browser.card.name": Text(color: "$ink", size: 11.0, font: "body"),
        "browser.badge": Text(color: "$muted", size: 9.0, font: "mono"),
        "browser.glyph": Text(color: "$muted", size: 22.0, font: "body"),

        // The strip across the top of a card is a rule in the rarity's ink.
        "browser.rarity": Solid(fill: "#00000000", radius: 0.0),
        "browser.rarity.common": Solid(fill: "#00000000", radius: 0.0),
        "browser.rarity.uncommon": Solid(fill: "$teal", radius: 0.0),
        "browser.rarity.rare": Solid(fill: "$orange", radius: 0.0),
        "browser.rarity.epic": Solid(fill: "#6B4FA0", radius: 0.0),
        "browser.rarity.legendary": Solid(fill: "$danger", radius: 0.0),

        // Chips and tabs are index tabs: square, the active one inked.
        "browser.chip": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "browser.chip.active": Solid(fill: "$ink", border: "$ink", radius: 2.0),
        "browser.chip.text": Text(color: "$ink", size: 12.0, font: "body"),
        "browser.chip.text.active": Text(color: "$paper", size: 12.0, font: "body"),

        "browser.search": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "browser.search.focus": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0),

        "browser.tab": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "browser.tab.active": Solid(fill: "$ink", border: "$ink", radius: 2.0),

        "browser.bookmark": Solid(fill: "#FFF3D6", border: "$orange", radius: 2.0),

        "browser.title": Text(color: "$ink", size: 18.0, font: "body"),
        "browser.pill": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "browser.pill.text": Text(color: "$ink", size: 12.0, font: "body"),

        "browser.status": Text(color: "$muted", size: 12.0, font: "mono"),
        "browser.hint": Text(color: "$muted", size: 11.0, font: "mono"),

        "browser.slot": Solid(fill: "$sheet", border: "$rule", radius: 2.0),
        "browser.slot.missing": Solid(fill: "#F6DAD3", border: "$danger", radius: 2.0),

        "browser.recipe.arrow": Solid(fill: "$rule", radius: 0.0),
        "browser.recipe.arrow.progress": Solid(fill: "$orange", radius: 0.0),

        "browser.button.disabled": Solid(fill: "$shade", border: "$rule", radius: 2.0),

        // Machine widgets are gauges drawn in ink; the fill takes the fluid
        // colour, teal until one is resolved.
        "tank": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "tank.fill": Solid(fill: "#2B8C86B3", radius: 0.0),
        "bar": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "bar.fill": Solid(fill: "$orange", radius: 0.0),
        "bar.text": Text(color: "$ink", size: 10.0, font: "mono"),
        "progress": Solid(fill: "$shade", border: "$rule", radius: 0.0),
        "progress.fill": Solid(fill: "$teal", radius: 0.0),

        // Side tabs are the index tabs on the edge of the manual.
        "tab.rail": Solid(fill: "#00000000"),
        "tab.side": Solid(fill: "$shade", border: "$ink", radius: 2.0, elevation: "ink"),
        "tab.side.open": Solid(fill: "$sheet", border: "$orange", radius: 2.0, elevation: "ink"),
        "tab.side.header": Solid(fill: "#00000000", radius: 2.0),
        "tab.side.content": Solid(fill: "$paper", border: "$rule", radius: 2.0),

        "icon_button": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "ink"),
        "icon_button.hover": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0, elevation: "ink"),

        "virtual_grid": Solid(fill: "#00000000"),
        "virtual_grid.scrollbar": Solid(fill: "$shade", border: "$rule", radius: 0.0),
        "virtual_grid.thumb": Solid(fill: "$ink", radius: 0.0),

        "viewport": Solid(fill: "$sheet", border: "$ink", radius: 2.0),

        // HUD layers are paper labels over the world.
        "hud.panel": Solid(fill: "#EDE6D6E6", border: "$ink", radius: 2.0),
        "hud.crosshair": Solid(fill: "$ink", radius: 0.0),
        "hud.edit.frame": Solid(fill: "#00000000", border: "$orange", radius: 0.0),

        // Menus M0: a dashed ink rule around the focused widget, and a light
        // wash under a modal.
        "focus.ring": Dashed(fill: "#00000000", stroke: "$ink", width: 2.0),
        "scrim": Solid(fill: "#00000033"),

        // Menus M1: ruled rows, ink boxes, no rounding.
        "text.display": Text(color: "$ink", size: "$display"),
        "text.heading": Text(color: "$ink", size: "$heading"),
        "text.label": Text(color: "$ink", size: "$label"),
        "text.caption": Text(color: "$muted", size: "$caption"),
        "text.key": Text(color: "$orange", size: "$label", font: "mono"),
        "text.icon": Text(color: "$teal", size: "$body", weight: 600),
        "text.inverse": Text(color: "$sheet", size: "$label", font: "mono"),
        "control.label": Text(color: "$ink", size: "$body"),
        "control.label.inverse": Text(color: "$sheet", size: "$body"),
        "text.label.inverse": Text(color: "$sheet", size: "$label"),
        "button.danger": Solid(fill: "$danger", border: "$ink", radius: 2.0, elevation: "ink"),
        // Menus M2: primary and danger keep their fill through the states;
        // paper's focus is a heavier ink frame, its press drops the shadow.
        "button.primary.hover": Solid(fill: "#F7A35C", border: "$ink", radius: 2.0, elevation: "ink"),
        "button.primary.focus": Solid(fill: "$orange", border: "$ink", radius: 2.0, elevation: "mid"),
        "button.primary.pressed": Solid(fill: "#D9772E", border: "$ink", radius: 2.0),
        "button.danger.hover": Solid(fill: "#C94A42", border: "$ink", radius: 2.0, elevation: "ink"),
        "button.danger.focus": Solid(fill: "$danger", border: "$ink", radius: 2.0, elevation: "mid"),
        "button.danger.pressed": Solid(fill: "#A32A23", border: "$ink", radius: 2.0),
        "button.focus": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0, elevation: "ink"),
        "button.pressed": Solid(fill: "$shade", border: "$ink", radius: 2.0),
        "button.disabled": Solid(fill: "$paper", border: "$rule", radius: 2.0),
        "toggle": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "toggle.on": Solid(fill: "$teal", border: "$ink", radius: 2.0),
        "toggle.thumb": Solid(fill: "$ink", radius: 0.0),
        "toggle.hover": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0),
        "toggle.focus": Solid(fill: "$sheet", border: "$orange", radius: 2.0),
        "toggle.disabled": Solid(fill: "$paper", border: "$rule", radius: 2.0),
        "checkbox": Solid(fill: "$sheet", border: "$ink", radius: 0.0),
        "checkbox.on": Solid(fill: "$ink", border: "$ink", radius: 0.0),
        "slider": Solid(fill: "$sheet", border: "$ink", radius: 0.0),
        "slider.fill": Solid(fill: "$teal", radius: 0.0),
        "slider.thumb": Solid(fill: "$ink", radius: 0.0),
        "slider.text": Text(color: "$ink", size: "$label", font: "mono"),
        "slider.focus": Solid(fill: "$sheet", border: "$orange", radius: 0.0),
        "slider.disabled": Solid(fill: "$paper", border: "$rule", radius: 0.0),
        "select": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "select.hover": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0),
        "select.focus": Solid(fill: "$sheet", border: "$orange", radius: 2.0),
        "select.popup": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "mid"),
        "select.option": Solid(fill: "#00000000", radius: 0.0),
        "select.option.active": Solid(fill: "$ink", radius: 0.0),
        "radio": Solid(fill: "$sheet", border: "$ink", radius: 0.0),
        "radio.active": Solid(fill: "$ink", border: "$ink", radius: 0.0),
        "key_binding": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "key_binding.capturing": Solid(fill: "$shade", border: "$orange", radius: 2.0),
        "text_field": Solid(fill: "$sheet", border: "$ink", radius: 2.0),
        "text_field.focus": Solid(fill: "#FFFCF4", border: "$orange", radius: 2.0),
        "text_field.disabled": Solid(fill: "$paper", border: "$rule", radius: 2.0),
        "text_field.placeholder": Text(color: "$muted", size: "$body"),
        "scroll.bar": Solid(fill: "$shade", radius: 0.0),
        "scroll.thumb": Solid(fill: "$ink", radius: 0.0),
        "list.row": Solid(fill: "#00000000", radius: 0.0),
        "list.row.hover": Solid(fill: "$shade", radius: 0.0),
        "list.row.focus": Solid(fill: "$shade", border: "$orange", radius: 0.0),
        "list.row.selected": Solid(fill: "$ink", radius: 0.0),
        "tabs.bar": Solid(fill: "#00000000"),
        "tab": Solid(fill: "$sheet", border: "$rule", radius: 0.0),
        "tab.active": Solid(fill: "$ink", border: "$ink", radius: 0.0),
        "tab.hover": Solid(fill: "#FFFCF4", border: "$orange", radius: 0.0),
        "tab.focus": Solid(fill: "$sheet", border: "$orange", radius: 0.0),
        "separator": Solid(fill: "$rule"),

        // Menus M2: ink-framed toasts, bracketed mono hints.
        "toast": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "ink"),
        "toast.info": Solid(fill: "$sheet", border: "$ink", radius: 2.0, elevation: "ink"),
        "toast.success": Solid(fill: "$sheet", border: "$teal", radius: 2.0, elevation: "ink"),
        "toast.warning": Solid(fill: "$sheet", border: "$orange", radius: 2.0, elevation: "ink"),
        "toast.error": Solid(fill: "$sheet", border: "$danger", radius: 2.0, elevation: "ink"),
        "toast.text": Text(color: "$ink", size: "$body"),
        "hint.bar": Solid(fill: "#00000000"),
        // A `Text` material on `hint.glyph` means "no pill": the bar draws
        // the glyph as bracketed mono text, `[A]`.
        "hint.glyph": Text(color: "$orange", size: "$label", font: "mono"),
        "hint.glyph.text": Text(color: "$orange", size: "$label", font: "mono"),
        "hint.label": Text(color: "$muted", size: "$caption"),
        "menu.title": Text(color: "$ink", size: "$display"),
        "menu.version": Text(color: "$muted", size: "$caption", font: "mono"),
        "dialogue": Solid(fill: "$sheet", border: "$ink", radius: 0.0, elevation: "ink"),
        "dialogue.speaker": Text(color: "$ink", size: "$label", font: "mono", weight: 700),
        "dialogue.text": Text(color: "$ink", size: "$body"),
        "dialogue.portrait": Solid(fill: "$sheet", border: "$ink", radius: 0.0),

        "invisible": Solid(fill: "#00000000"),
    },
)
